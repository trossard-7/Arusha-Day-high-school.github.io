# KAidO High School Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kaido_school

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
ADMIN_EMAIL=admissions@kaido.edu

# Admin Panel
ADMIN_PANEL_URL=http://localhost:3000/admin

# JWT Secret (for future authentication)
JWT_SECRET=your-jwt-secret-key-here

# CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Application Settings
APPLICATION_DEADLINE=2025-03-31
EXAM_DATE_START=2025-04-15
EXAM_DATE_END=2025-04-17
INTERVIEW_DATE_START=2025-05-01
INTERVIEW_DATE_END=2025-05-10
RESULTS_DATE=2025-06-01